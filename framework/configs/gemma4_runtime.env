#!/usr/bin/env bash

# Runtime pin for google/gemma-4-31B-it.
# vLLM 0.27.1 bundles Transformers 5.15.0, whose heterogeneous-config API
# breaks Gemma 4 startup.  This project-local layer safely shadows only the
# Transformers package with the upstream-confirmed 5.14.1 workaround.
export MODEL_ID="google/gemma-4-31B-it"
export MODEL_TAG="gemma4_31b"
export MODEL_CONFIG="/data/groups/cmb/lennart.martens/HAMLET/textmining/framework/configs/gemma4_31b_vllm.yaml"
export VLLM_SIF="/data/groups/cmb/lennart.martens/HAMLET/containers/vllm-openai-v0.27.1.sif"
export HAMLET_VLLM_PYTHONPATH="/data/groups/cmb/lennart.martens/HAMLET/containers/python_overlays/transformers-5.14.1"
export HAMLET_VLLM_LANGUAGE_MODEL_ONLY=1
export HAMLET_VLLM_ATTENTION_BACKEND="TRITON_ATTN"
export VLLM_MAX_MODEL_LEN="32768"
